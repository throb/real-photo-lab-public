{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "real-photo-lab-public.vercel.app"
        }
      ],
      "destination": "https://realphotolab.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.realphotolab.com"
        }
      ],
      "destination": "https://realphotolab.com/:path*",
      "permanent": true
    }
  ]
}